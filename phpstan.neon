includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - config/
        - database/
        - resources/
        - src/
        - tests/

    level: 7

    ignoreErrors:
        # The package's own config file: Larastan only recognizes the host's config/ directory.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/basics13.php
