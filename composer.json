{
    "name": "amaia/basics13",
    "description": "Generic Laravel 13 components: audit traits, base controllers, requests, queries, transformers, and view components for resource CRUD with soft deletes, archive, and trash.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.5",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13",
        "livewire/flux": "^2",
        "livewire/livewire": "^4.1",
        "maatwebsite/excel": "^4.0",
        "opcodesio/log-viewer": "^3.24"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/dusk": "^8.7",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Basics13\\Database\\Factories\\": "database/factories/",
            "Basics13\\Database\\Seeders\\": "database/seeders/",
            "Basics13\\": "src/"
        },
        "files": [
            "src/Support/Database/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Basics13\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Basics13\\ServiceProvider",
                "Basics13\\Auth\\FortifyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
